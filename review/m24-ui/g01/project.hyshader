  "sound": {
    "id": "sound",
    "enabled": false,
    "code": "// 左右声道范围 -1 到 1；时间单位为秒。\nfn mainSound(sampleIndex: i32, time: f32) -> vec2f {\n  let beat = floor(time * 4.0);\n  let note = select(select(60.0, 64.0, beat % 4.0 == 1.0), select(67.0, 72.0, beat % 4.0 == 3.0), beat % 4.0 >= 2.0);\n  let frequency = 440.0 * pow(2.0, (note - 69.0) / 12.0);\n  let phase = fract(time * 4.0);\n  let envelope = smoothstep(0.0, 0.02, phase) * exp(-phase * 5.0);\n  let tone = sin(6.2831853 * frequency * time) * envelope * 0.3;\n  return vec2f(tone, tone);\n}",
    "channels": [
      {
        "kind": "none"
      },
      {
        "kind": "none"
      },
      {
        "kind": "none"
      },
      {
        "kind": "none"
      }
    ],
    "duration": 60,
    "volume": 0.25
  },
