<resources>
    <!-- NativeScript's API-specific themes inherit these base styles. -->
    <style name="AppThemeBase" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="toolbarStyle">@style/NativeScriptToolbarStyle</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101318</item>
        <item name="android:navigationBarColor">#101318</item>
        <item name="colorAccent">#B8ED65</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
    <style name="NativeScriptToolbarStyleBase" parent="Widget.AppCompat.Toolbar" />
    <style name="NativeScriptToolbarStyle" parent="NativeScriptToolbarStyleBase" />
</resources>
