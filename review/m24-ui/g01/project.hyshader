      "code": "// fragCoord: 像素坐标，原点在左下角\nfn mainImage(fragCoord: vec2f) -> vec4f {\n  let uv = fragCoord / iResolution.xy;\n  let color = vec3f(0.5) + 0.5 * cos(vec3f(iTime) + uv.xyx + vec3f(0.0, 2.0, 4.0));\n  return vec4f(color, 1.0);\n}",
