{
  "name": "@haiyue/shader-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ShaderLab Web editor",
  "license": "MIT",
  "engines": {
    "node": ">=24.12"
  },
  "main": "electron/main.mjs",
  "scripts": {
    "build:types": "npm run build:shared --prefix .. && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run build:types && node ../scripts/build-rollup-once.mjs --expect web",
    "build:app": "npm run build && node ../scripts/run-editor-app-kit.mjs assemble",
    "app:check": "npm run build:app && node ../scripts/run-editor-app-kit.mjs validate",
    "preview": "npm run build:app && node ../scripts/run-editor-app-kit.mjs preview",
    "test": "npm run build:types && node --test test/*.test.mjs",
    "test:browser": "npm run build:app && node ../test/shared-ui/browser.mjs && node ../test/shared-ui/legacy-browser.mjs",
    "test:electron": "npm run build:app && node test/electron-smoke.mjs",
    "electron:start": "npm run build:app && electron .",
    "electron:pack": "npm run build:app && node ../scripts/run-editor-app-kit.mjs electron-pack"
  },
  "dependencies": {
    "@haiyue/ui": "0.2.1-p1.3",
    "@haiyue/engine": ">=0.1.0 <0.2.0",
    "@haiyue/editor-platform": "0.1.0",
    "@haiyue/editor-plugin-sdk": "0.1.0",
    "@haiyue/editor-app-kit": "0.1.0",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/language": "^6.10.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.33.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/autocomplete": "^6.18.0",
    "@lezer/highlight": "^1.2.1",
    "codemirror": "^6.0.1",
    "naga-wasm": "30.2.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@webgpu/types": "^0.1.40",
    "electron": "43.2.0",
    "rollup": "^4.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.2.0"
  }
}
