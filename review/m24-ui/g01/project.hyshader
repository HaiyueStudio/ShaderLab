      "enabled": false,
      "code": "fn mainImage(fragCoord: vec2f) -> vec4f {\n  let uv = fragCoord / iResolution.xy;\n  return vec4f(uv, 0.5 + 0.5 * sin(iTime), 1.0);\n}",
